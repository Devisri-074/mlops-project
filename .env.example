# ==============================================================================
# ChurnWise Full-Stack & MLOps System - Environment Configuration
# ==============================================================================

# 1. FastAPI Prediction Microservice (Port 8000)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# 2. MLflow Experiment Tracking UI (Port 8080)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns
MLFLOW_EXPERIMENT_NAME=ChurnWise_Retention_System
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=8080

# 3. Node.js Express REST API (Port 5000)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=churnwise_jwt_secret_key_example_change_me
JWT_EXPIRES_IN=7d
FASTAPI_URL=http://127.0.0.1:8000

# 4. MySQL Database Configuration (Optional - automated JSON fallback used if offline)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=churnwise_db
