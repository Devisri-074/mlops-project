# ==============================================================================
# ChurnWise Node.js Express Backend - Environment Variables
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=churnwise_jwt_secret_key_example_change_me
JWT_EXPIRES_IN=7d

# Python FastAPI MLOps Microservice URL
FASTAPI_URL=http://127.0.0.1:8000

# MySQL Database Configuration (Optional - graceful JSON fallback used if offline)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=churnwise_db
